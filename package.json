{
  "name": "darshan-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "cms": "npx @sveltia/cms-auth@latest",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test",
    "clean": "rm -rf .next out build node_modules/.cache"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ladle/react": "^5.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/marked": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jsdom": "^27.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5",
    "vite": "^7.1.12",
    "vitest": "^4.0.3"
  },
  "volta": {
    "node": "22.20.0"
  }
}
